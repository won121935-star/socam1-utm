# socam1-utm 환경변수.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# === DB ===
# 로컬 개발: 파일 SQLite (libsql 어댑터가 file: 도 지원)
DATABASE_URL="file:./dev.db"

# 프로덕션 (Vercel) 배포 시:
#   DATABASE_URL=libsql://<your-db>.turso.io
TURSO_AUTH_TOKEN=

# === Google OAuth (GA 4 분석 연동) ===
# 발급: https://console.cloud.google.com/ → API & Services → Credentials
#       → Create credentials → OAuth client ID → Web application
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/google/callback (로컬)
#   - https://<your-vercel-url>/api/auth/google/callback (프로덕션)
# 추가로: API Library 에서 "Google Analytics Admin API" + "Google Analytics Data API" enable 필수
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
